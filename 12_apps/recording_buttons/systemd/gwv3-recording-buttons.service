[Unit]
Description=GWV3 recording control buttons
After=network-online.target xiaohuan-wake.service
Wants=network-online.target xiaohuan-wake.service

[Service]
Type=simple
WorkingDirectory=%h/wireless_video_delivery/12_apps/recording_buttons
ExecStart=/usr/bin/python3 -u %h/wireless_video_delivery/12_apps/recording_buttons/recording_button_service.py --config %h/wireless_video_delivery/12_apps/recording_buttons/config_lubancat-52d2ef0c.json
Restart=always
RestartSec=2
TimeoutStopSec=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
