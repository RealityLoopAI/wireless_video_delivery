[Unit]
Description=GWV3 recording control buttons
After=network-online.target xiaohuan-wake.service
Wants=network-online.target xiaohuan-wake.service

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 -u @APP_DIR@/recording_button_service.py --config @APP_DIR@/config_lubancat-local.json
Restart=always
RestartSec=2
TimeoutStopSec=6
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
