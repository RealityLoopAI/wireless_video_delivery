# Xiaohuan owns these USB audio devices through direct ALSA access.
# PulseAudio probing after hub re-enumeration otherwise races the capture recovery.
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="8087", ATTRS{idProduct}=="1024", ENV{PULSE_IGNORE}="1"
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="08bb", ATTRS{idProduct}=="2902", ENV{PULSE_IGNORE}="1"
