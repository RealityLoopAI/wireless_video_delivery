[Unit]
Description=Xiaohuan voice wake listener
After=sound.target pipewire.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory="@APP_DIR@"
ExecStart="@APP_DIR@/run_wake_service.sh"
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=default.target
