{
  "camera": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "format_priority": [
      "RGB",
      "MJPG",
      "YUYV",
      "NV12"
    ],
    "auto_exposure": true
  },
  "codec": {
    "codec": "h264",
    "bitrate_kbps": 5000,
    "gop": 30,
    "max_b_frames": 0,
    "preset": "ultrafast",
    "tune": "zerolatency",
    "thread_count": 4,
    "thread_type": "frame"
  },
  "network": {
    "remote_ip": "192.168.1.105",
    "remote_port": 5600,
    "mtu": 1200,
    "ttl": 64,
    "socket_buffer_bytes": 4194304
  },
  "runtime": {
    "queue_size": 4,
    "camera_timeout_ms": 100,
    "watchdog_interval_ms": 1000,
    "degraded_threshold": 10,
    "reconnect_backoff_ms": [
      1000,
      2000,
      5000,
      10000
    ],
    "log_interval_ms": 2000,
    "drop_frame_divisor": 1,
    "adaptive_drop_enabled": false
  }
}
