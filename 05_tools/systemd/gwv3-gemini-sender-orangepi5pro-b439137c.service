[Unit]
Description=GWV3 Gemini RGBD Sender (orangepi5pro-b439137c)
Wants=network-online.target
After=network-online.target chrony.service gemini-sender-prepare.service

[Service]
Type=simple
User=orangepi
Group=orangepi
SupplementaryGroups=video render
WorkingDirectory=/home/orangepi/Downloads/wireless_video_delivery
Environment=HOME=/home/orangepi
Environment=GEMINI_SENDER_MEDIA_OUTAGE_RESTART_SAMPLES=0
ExecStartPre=+/home/orangepi/Downloads/wireless_video_delivery/05_tools/prepare_rk3588_usb.sh
ExecStart=/home/orangepi/Downloads/wireless_video_delivery/05_tools/sender_watchdog.sh /home/orangepi/Downloads/wireless_video_delivery/06_configs/sender_orangepi5pro-b439137c.json no-local-preview
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
