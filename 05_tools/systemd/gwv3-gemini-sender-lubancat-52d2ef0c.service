[Unit]
Description=GWV3 Gemini RGBD Sender (lubancat-52d2ef0c)
After=network-online.target chrony.service
Wants=network-online.target chrony.service

[Service]
Type=simple
User=cat
Group=cat
SupplementaryGroups=video render
WorkingDirectory=/home/cat/wireless_video_delivery
Environment=HOME=/home/cat
Environment=ORBBEC_SDK_ROOT=/home/cat/wireless_video_delivery/11_third_party/orbbec/linux_arm64/OrbbecSDK_v2.8.6
Environment=GST_PLUGIN_PATH_1_0=/home/cat/wireless_video_runtime/gstreamer-1.0
Environment=GEMINI_CHRONY_MAX_CORRECTION_S=0.010
Environment=GEMINI_SENDER_MEDIA_OUTAGE_RESTART_SAMPLES=30
ExecStartPre=+/home/cat/wireless_video_delivery/05_tools/prepare_rk3588_usb.sh
ExecStart=/home/cat/wireless_video_delivery/05_tools/sender_watchdog.sh /home/cat/wireless_video_delivery/06_configs/sender_lubancat-52d2ef0c_gemini305.json no-local-preview
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
