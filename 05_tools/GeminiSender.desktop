[Desktop Entry]
Type=Application
Name=Gemini Sender
Comment=Start Gemini wireless video sender
Exec=/bin/bash -lc "for d in \"\\$HOME/Desktop/wireless_video_delivery\" \"\\$HOME/Downloads/wireless_video_delivery\"; do if [ -x \"\\$d/05_tools/run_sender_foreground.sh\" ]; then exec \"\\$d/05_tools/run_sender_foreground.sh\"; fi; done; exit 1"
Terminal=true
Categories=Utility;
